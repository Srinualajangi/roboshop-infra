#!/bin/bash
# Runs ONCE as root on first boot. Keep it tiny - everything else is in Git (workstation/bootstrap.sh).
set -euo pipefail
exec > >(tee -a /var/log/roboshop-user-data.log) 2>&1

# 1. Dead-man switch: power off (= terminate) after N minutes, even if you forget `make down`
shutdown -h +${auto_shutdown_minutes} "roboshop lab auto-shutdown" || true

# 2. SSM agent (preinstalled on Amazon Linux, NOT on RHEL)
if ! systemctl list-unit-files | grep -q '^amazon-ssm-agent'; then
  dnf install -y https://s3.amazonaws.com/ec2-downloads-windows/SSMAgent/latest/linux_amd64/amazon-ssm-agent.rpm
fi
systemctl enable --now amazon-ssm-agent

# 3. SSH: keys only, and authorise the laptop key (SSH itself is only reachable through SSM)
install -d -m 700 -o ec2-user -g ec2-user /home/ec2-user/.ssh
echo "${ssh_public_key}" >> /home/ec2-user/.ssh/authorized_keys
chown ec2-user:ec2-user /home/ec2-user/.ssh/authorized_keys && chmod 600 /home/ec2-user/.ssh/authorized_keys
printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\nPermitRootLogin no\n' > /etc/ssh/sshd_config.d/00-roboshop.conf
systemctl restart sshd

# Expand workstation disk/LVM automatically

dnf install -y cloud-utils-growpart lvm2 || true

sleep 10

growpart /dev/nvme0n1 4 || true

partprobe /dev/nvme0n1 || true

pvresize /dev/nvme0n1p4 || true

lvextend -l +100%FREE -r /dev/RootVG/varVol || true

df -h /var || true

# 4. Hand over to the bootstrap script in Git
TOKEN=$(curl -sX PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')
IID=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
dnf install -y git
rm -rf /opt/roboshop-infra
git clone --depth 1 -b ${git_branch} https://github.com/${gh_user}/roboshop-infra.git /opt/roboshop-infra
GH_USER=${gh_user} INSTANCE_ID=$IID LAB_PROFILES_OVERRIDE="${lab_profiles}" LAB_STEPS_OVERRIDE="${lab_steps}" \
  bash /opt/roboshop-infra/workstation/bootstrap.sh
