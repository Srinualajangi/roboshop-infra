# roboshop-infra/workstation/lab.env  (fast-track kit version)
# What the workstation rebuilds at boot, in this order. Each name = workstation/steps/<name>.sh (run as ec2-user).
#   core boot (always):      tools repos kind argocd root-app
#   + "sonar"  only together with the "ci" profile (creates the SonarQube token for Jenkins)
#   + "velero" only for DR drills (needs the VeleroBucket IAM statement -> make apply LAYER=10-foundation)
LAB_STEPS="tools repos kind argocd root-app"

# Add-on profiles on top of the core platform (each = one Argo CD app over roboshop-gitops/argocd-addons/<name>):
#   ""            core only: kind, Argo CD, Traefik/Gateway API, ESO, Rollouts, 3 envs x 12 services  (~15 min, m6i.2xlarge)
#   "obs"         + Prometheus/Grafana/Alertmanager, Loki/Alloy, Tempo/OTel           (+5 min, +4 GiB)
#   "obs sec"     + Kyverno (Audit) and Trivy Operator                                (+2 min, +1.5 GiB)
#   "obs sec ci"  + Jenkins and SonarQube (also add "sonar" to LAB_STEPS)             (+5 min, +5 GiB -> r6i.2xlarge)
LAB_PROFILES=""

# Used by the repos step for commits made on the workstation (use your GitHub noreply address)
GIT_NAME="Srinu Alajangi"
GIT_EMAIL="139538521+Srinualajangi@users.noreply.github.com"
