# roboshop-infra/workstation/versions.env
# Pinned tool versions for the workstation. Change deliberately, one tool at a time.
# Leading "v" for all except TRIVY_VERSION and TERRAFORM_VERSION (their download URLs have no "v").
KUBECTL_VERSION=v1.37.1   # pinned 2026-10-11 by ft-pin-versions.sh
KIND_VERSION=v0.33.0   # pinned 2026-10-11 by ft-pin-versions.sh
HELM_VERSION=v4.3.0   # pinned 2026-10-11 by ft-pin-versions.sh
K9S_VERSION=v0.51.0   # pinned 2026-10-11 by ft-pin-versions.sh
YQ_VERSION=v4.54.1   # pinned 2026-10-11 by ft-pin-versions.sh
TRIVY_VERSION=0.75.0   # pinned 2026-10-11 by ft-pin-versions.sh
ARGOCD_VERSION=v3.5.4   # pinned 2026-10-11 by ft-pin-versions.sh
TERRAFORM_VERSION=1.16.5   # pinned 2026-10-11 by ft-pin-versions.sh
GATEWAY_API_VERSION=v1.6.3   # pinned 2026-10-11 by ft-pin-versions.sh
TRAEFIK_CHART_VERSION=41.7.1   # pinned 2026-10-11 by ft-pin-versions.sh
ARGOCD_CHART_VERSION=10.10.2   # pinned 2026-10-11 by ft-pin-versions.sh
KPS_CHART_VERSION=92.3.0   # pinned 2026-10-11 by ft-pin-versions.sh
PROM_CRDS_CHART_VERSION=32.0.1   # pinned 2026-10-11 by ft-pin-versions.sh
ROLLOUTS_CHART_VERSION=2.43.6   # pinned 2026-10-11 by ft-pin-versions.sh
ROLLOUTS_VERSION=v1.10.0   # pinned 2026-10-11 by ft-pin-versions.sh
KIND_NODE_IMAGE=""   # empty = default node image of the pinned kind release

# Added later in the guide - pin each with scripts/latest-versions.sh / helm search repo (placeholders!)
CALICO_VERSION=v3.33.0   # pinned 2026-10-11 by ft-pin-versions.sh
COSIGN_VERSION=v3.1.3   # pinned 2026-10-11 by ft-pin-versions.sh
HADOLINT_VERSION=v2.15.1   # pinned 2026-10-11 by ft-pin-versions.sh
METRICS_SERVER_CHART_VERSION=3.14.0   # pinned 2026-10-11 by ft-pin-versions.sh
PLUTO_VERSION=v5.24.4   # pinned 2026-10-11 by ft-pin-versions.sh
VELERO_AWS_PLUGIN_VERSION=v1.14.4   # pinned 2026-10-11 by ft-pin-versions.sh
